# --- Classifieds Pro backend configuration ---
# Copy this file to app/backend/.env and fill in real values.
# app/backend/.env is git-ignored — never commit real credentials.

# MongoDB
MONGO_URL="mongodb://localhost:27017"
DB_NAME="classifieds_pro"
# How long to wait for MongoDB before giving up at startup (milliseconds)
MONGO_SERVER_SELECTION_TIMEOUT_MS=2500

# CORS — comma-separated list of allowed origins for the web dashboard.
# Do NOT use "*" together with credentialed requests.
CORS_ORIGINS="http://localhost:3000"

# --- Security ---
# Admin API key. When set, every /api route except /api, /api/health and
# /api/auth/login requires:  Authorization: Bearer <ADMIN_API_KEY>
# The same value is used as the dashboard password on the login screen.
# When unset, the API runs in open development mode (NOT for production).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=""

# Fernet key used to encrypt wanuncios.com passwords at rest.
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, an ephemeral key is generated at startup and encrypted credentials
# become unreadable after restart. Set this before storing real accounts.
CREDENTIAL_ENCRYPTION_KEY=""

# --- Third-party services ---
# LLM key used by the AI ad-text generator (placeholder implementation until then)
UNIVERSAL_KEY=""
# 2captcha API key used by the automation service to solve reCAPTCHAs
TWOCAPTCHA_API_KEY=""

# Rate limiting (set to "false" to disable, e.g. in tests)
RATE_LIMIT_ENABLED="true"
